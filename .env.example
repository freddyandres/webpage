# Copia este archivo como referencia para configurar el hosting. NUNCA subas contraseñas reales al repositorio.
PORT=3000
NODE_ENV=production
# Carpeta donde se guardan la base de datos y las fotografías (debe ser un disco persistente)
DATA_DIR=/var/data/patita
# true si el sitio se sirve con HTTPS (cookie segura)
COOKIE_SECURE=true
# true si hay un proxy inverso delante (Render, Railway, Nginx…)
TRUST_PROXY=true
# Opcional: crea las cuentas iniciales al arrancar si aún no existen (defínelas como secretos del hosting)
# ADMIN_SAMANTHA_PASSWORD=
# ADMIN_ANGEL_PASSWORD=
